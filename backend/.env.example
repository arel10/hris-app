APP_ENV=development
APP_PORT=8080
APP_NAME=peoplecore-api

DATABASE_URL=postgres://peoplecore_user:peoplecore_pass@localhost:5433/peoplecore?sslmode=disable

JWT_ACCESS_SECRET=replace_with_strong_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

CORS_ALLOWED_ORIGINS=http://localhost:5173

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

